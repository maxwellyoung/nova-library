+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "DeviceLibrary.h"
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QProcess>
+#include <QStandardPaths>
+#ifdef Q_OS_UNIX
+#include <unistd.h>
+#endif
+#ifdef Q_OS_ANDROID
+#include <QAndroidJniObject>
+#include <QAndroidJniEnvironment>
+#endif
+namespace library {
+QString linuxStoragePath(const QString& overridePath, const QString& fallbackPath) {
+    const QString path = overridePath.isEmpty() ? fallbackPath : overridePath;
+    if (path.isEmpty() || !QDir::isAbsolutePath(path) || QDir::cleanPath(path) == "/" ||
+        path.split('/').contains("..")) return {};
+    const QString cleaned = QDir::cleanPath(path);
+    QFileInfo info(cleaned);
+    // Reject final-component symlinks and files. Parent links such as /home on
+    // Bazzite are allowed; return the resolved private directory consistently.
+    if (info.isSymLink() || (info.exists() && !info.isDir())) return {};
+    if (!info.exists() && !QDir().mkpath(cleaned)) return {};
+    info.refresh();
+    if (!info.isDir() || info.isSymLink()) return {};
+#ifdef Q_OS_UNIX
+    if (info.ownerId() != uint(getuid())) return {};
+#endif
+    const QFileDevice::Permissions permissions = QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner;
+    if (!QFile::setPermissions(cleaned, permissions)) return {};
+    info.refresh();
+    const QFileDevice::Permissions unsafe = QFileDevice::ReadGroup | QFileDevice::WriteGroup | QFileDevice::ExeGroup |
+        QFileDevice::ReadOther | QFileDevice::WriteOther | QFileDevice::ExeOther;
+    if ((info.permissions() & unsafe) != 0) return {};
+    return info.canonicalFilePath();
+}
+bool enrollmentDeviceMatches(const QString& enrolledDeviceId, const QString& launcherDeviceId) {
+    if (launcherDeviceId.isEmpty()) return true;
+    if (launcherDeviceId.size() > 200 || enrolledDeviceId != launcherDeviceId) return false;
+    for (const QChar c : launcherDeviceId) if (c.unicode() < 32) return false;
+    return true;
+}
+QString platformStoragePath() {
+#ifdef Q_OS_ANDROID
+    QAndroidJniObject path = QAndroidJniObject::callStaticObjectMethod("org/pegasus_frontend/android/DeviceLibraryVault", "storagePath", "()Ljava/lang/String;");
+    QAndroidJniEnvironment env;
+    if (env->ExceptionCheck()) { env->ExceptionClear(); return QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/device-library"; }
+    return path.toString();
+#elif defined(Q_OS_LINUX)
+    return linuxStoragePath(qEnvironmentVariable("DEVICE_LIBRARY_DIR"),
+        QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/device-library");
+#else
+    return QStandardPaths::writableLocation(QStandardPaths::AppDataLocation) + "/device-library";
+#endif
+}
+Enrollment platformEnrollment() {
+    QByteArray bytes;
+#ifdef Q_OS_ANDROID
+    QAndroidJniObject payload = QAndroidJniObject::callStaticObjectMethod("org/pegasus_frontend/android/DeviceLibraryVault", "enrollment", "()Ljava/lang/String;");
+    QAndroidJniEnvironment env;
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    else bytes = payload.toString().toUtf8();
+#else
+    const QString storage = platformStoragePath();
+    if (storage.isEmpty()) return {};
+    QFile config(storage + "/config.json");
+    if (config.open(QIODevice::ReadOnly) && config.size() <= 16384) bytes = config.readAll();
+#endif
+    QJsonObject o = QJsonDocument::fromJson(bytes).object();
+    Enrollment e; e.endpoint = QUrl(o.value("endpoint").toString()); e.deviceId = o.value("deviceId").toString(); e.transport = o.value("transport").toString(); e.bootstrapPath = o.value("bootstrapPath").toString();
+#ifdef Q_OS_ANDROID
+    e.token = o.value("token").toString().toUtf8();
+#else
+#ifdef Q_OS_LINUX
+    if (!enrollmentDeviceMatches(e.deviceId, qEnvironmentVariable("DEVICE_LIBRARY_DEVICE_ID"))) return {};
+#endif
+    if (DeviceLibrary::allowedEndpoint(e) && !e.deviceId.isEmpty()) {
+        // Secret Service owns the token. Config files and SQLite never contain it.
+        const QString executable = QStandardPaths::findExecutable("secret-tool");
+        if (!executable.isEmpty()) {
+            QProcess lookup; lookup.setProgram(executable); lookup.setArguments({"lookup", "application", "info.maxwellyoung.library", "deviceId", e.deviceId, "endpoint", e.endpoint.toString()}); lookup.start();
+            if (lookup.waitForFinished(1500) && lookup.exitCode() == 0) e.token = lookup.readAllStandardOutput().trimmed();
+            else { lookup.kill(); lookup.waitForFinished(100); }
+        }
+    }
+#endif
+    if (!DeviceLibrary::allowedEndpoint(e) || e.token.size() > 8192 || e.token.contains('\n') || e.token.contains('\r')) e.token.clear();
+    return e;
+}
+} // namespace library
