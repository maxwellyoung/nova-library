+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "DeviceLibrary.h"
+#include <QtTest>
+#include <QTemporaryDir>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QFile>
+using namespace library;
+class DeviceLibraryTest : public QObject {
+    Q_OBJECT
+    QByteArray seed(const QString& text = "before", int rev = 0) {
+        return QJsonDocument::fromVariant(QVariantMap{{"version",1},{"revision","snapshot"},{"deviceId","test"},{"editions",QVariantList{QVariantMap{{"editionId","game"},{"title","Game"}}}},{"personal",QVariantMap{{"entries",QVariantMap{{"game",QVariantMap{{"checkpoint",text},{"status","unknown"},{"revision",rev}}}}},{"threads",QVariantList()}}},{"recommendations",QVariantList()},{"threads",QVariantList()}}).toJson();
+    }
+    QVariantMap entry(DeviceLibrary& lib) { return lib.read().value("personal").toMap().value("entries").toMap().value("game").toMap(); }
+    Enrollment enrollment() { Enrollment e; e.deviceId = "test"; return e; }
+    QByteArray ack(const QString& id, int rev=1) { return QJsonDocument::fromVariant(QVariantMap{{"ok",true},{"queued",false},{"actionId",id},{"receivedAt",1},{"revision",rev}}).toJson(); }
+private slots:
+    void offlineRestart() {
+        QTemporaryDir dir; const QString path=dir.path()+"/db.sqlite";
+        QByteArray action;
+        { DeviceLibrary lib(path,enrollment()); QVERIFY(lib.acceptSnapshot(seed())); auto r=lib.act({{"type","checkpoint"},{"editionId","game"},{"text","saved offline"}}); QVERIFY(r.value("queued").toBool()); action=lib.nextAction(); QCOMPARE(entry(lib).value("checkpoint").toString(),QString("saved offline")); }
+        DeviceLibrary lib(path,enrollment()); QCOMPARE(lib.nextAction(),action); QVERIFY(entry(lib).value("pending").toBool()); QCOMPARE(entry(lib).value("checkpoint").toString(),QString("saved offline"));
+    }
+    void lostAckAndDuplicate() {
+        DeviceLibrary lib(":memory:",enrollment()); QVERIFY(lib.acceptSnapshot(seed()));
+        const auto r=lib.act({{"type","checkpoint"},{"editionId","game"},{"text","new"},{"actionId","same"}});
+        const QByteArray queued=lib.nextAction(); QCOMPARE(lib.nextAction(),queued); QVERIFY(lib.act({{"type","checkpoint"},{"editionId","game"},{"text","new"},{"actionId","same"}}).value("ok").toBool()); QCOMPARE(lib.nextAction(),queued); QVERIFY(lib.acceptReceipt("same",ack("same"))); QVERIFY(lib.acceptReceipt("same",ack("same"))); QVERIFY(lib.nextAction().isEmpty()); QCOMPARE(entry(lib).value("checkpoint").toString(),QString("new"));
+        QVERIFY(lib.acceptSnapshot(seed("new",1))); QCOMPARE(entry(lib).value("revision").toInt(),1);
+        QCOMPARE(lib.act({{"type","checkpoint"},{"editionId","game"},{"text","different"},{"actionId","same"},{"expectedRevision",0}}).value("error").toString(),QString("action_id_reused"));
+    }
+    void conflictRetainedAndDependentBlocked() {
+        QTemporaryDir dir; QString path=dir.path()+"/db.sqlite";
+        { DeviceLibrary lib(path,enrollment()); QVERIFY(lib.acceptSnapshot(seed())); QVERIFY(lib.act({{"type","checkpoint"},{"editionId","game"},{"text","mine"},{"actionId","first"}}).value("ok").toBool()); QVERIFY(lib.act({{"type","status"},{"editionId","game"},{"status","playing"},{"actionId","second"}}).value("ok").toBool());
+        QByteArray conflict=QJsonDocument::fromVariant(QVariantMap{{"ok",false},{"queued",false},{"actionId","first"},{"error","revision_conflict"},{"conflict",QVariantMap{{"current",QVariantMap{{"checkpoint","theirs"},{"revision",1}}},{"submitted",QJsonDocument::fromJson(lib.nextAction()).object().toVariantMap()}}}}).toJson();
+        QVERIFY(lib.acceptReceipt("first",conflict)); QVERIFY(lib.nextAction().isEmpty()); QVERIFY(lib.acceptSnapshot(seed("theirs",1))); QCOMPARE(entry(lib).value("checkpoint").toString(),QString("mine")); QVERIFY(!entry(lib).value("conflict").toMap().isEmpty()); }
+        DeviceLibrary lib(path,enrollment()); QVERIFY(!entry(lib).value("conflict").toMap().isEmpty()); QVERIFY(lib.nextAction().isEmpty()); QCOMPARE(lib.read().value("sync").toMap().value("pending").toInt(),1);
+    }
+    void invalidSnapshotsPreservePending() {
+        DeviceLibrary lib(":memory:",enrollment()); QVERIFY(lib.acceptSnapshot(seed())); QVERIFY(lib.act({{"type","checkpoint"},{"editionId","game"},{"text","pending"}}).value("ok").toBool()); QByteArray before=lib.nextAction();
+        QVERIFY(!lib.acceptSnapshot("{broken")); QVERIFY(!lib.acceptSnapshot(QByteArray(5*1024*1024+1,' '))); QVERIFY(!lib.acceptSnapshot("{\"version\":1}")); QCOMPARE(lib.nextAction(),before); QCOMPARE(entry(lib).value("checkpoint").toString(),QString("pending")); QCOMPARE(lib.read().value("editions").toList().size(),1);
+    }
+    void revisionPredictionAndNoLaunch() {
+        DeviceLibrary lib(":memory:",enrollment()); QVERIFY(lib.acceptSnapshot(seed())); QVERIFY(lib.act({{"type","checkpoint"},{"editionId","game"},{"text","1"}}).value("ok").toBool()); QVERIFY(lib.act({{"type","status"},{"editionId","game"},{"status","playing"}}).value("ok").toBool()); QCOMPARE(entry(lib).value("revision").toInt(),2); QVERIFY(!lib.act({{"type","launch"},{"editionId","game"}}).value("ok").toBool());
+    }
+    void canonSnapshotConformance() {
+        DeviceLibrary lib(":memory:",enrollment());
+        QFile fixture(QFINDTESTDATA("fixtures/canon-v1.json")); QVERIFY(fixture.open(QIODevice::ReadOnly)); QVERIFY(lib.acceptSnapshot(fixture.readAll()));
+        QCOMPARE(lib.read().value("editions").toList().size(),2);
+        QVERIFY(lib.read().value("personal").toMap().value("entries").toMap().value("nova:snes:abc").toMap().value("checkpoint").isNull());
+        QCOMPARE(lib.read().value("sync").toMap().value("state").toString(),QString("conflict"));
+        QCOMPARE(lib.read().value("personal").toMap().value("threads").toList().size(),1);
+    }
+    void rejectExecutableSnapshotAndWrongDevice() {
+        DeviceLibrary lib(":memory:",enrollment()); QVERIFY(lib.acceptSnapshot(seed()));
+        QJsonObject bad=QJsonDocument::fromJson(seed()).object(); bad["command"]="remote-executable"; QVERIFY(!lib.acceptSnapshot(QJsonDocument(bad).toJson()));
+        bad=QJsonDocument::fromJson(seed()).object(); bad["deviceId"]="another-device"; QVERIFY(!lib.acceptSnapshot(QJsonDocument(bad).toJson()));
+        QCOMPARE(lib.read().value("editions").toList().size(),1);
+    }
+    void threadActionsAndPin() {
+        DeviceLibrary lib(":memory:",enrollment()); QVERIFY(lib.acceptSnapshot(seed()));
+        QVERIFY(lib.act({{"type","thread-keep"},{"suggestedId","group"},{"name","Keep"},{"members",QVariantList{"game"}},{"actionId","keep"}}).value("queued").toBool());
+        QCOMPARE(lib.read().value("personal").toMap().value("threads").toList().size(),1);
+        QByteArray receipt=QJsonDocument::fromVariant(QVariantMap{{"ok",true},{"queued",false},{"actionId","keep"},{"revision",1},{"threadId","thread:kept"}}).toJson(); QVERIFY(lib.acceptReceipt("keep",receipt));
+        QVERIFY(lib.act({{"type","thread-membership"},{"threadId","thread:kept"},{"editionId","game"},{"member",false}}).value("queued").toBool());
+        auto thread=lib.read().value("personal").toMap().value("threads").toList().first().toMap(); QVERIFY(thread.value("members").toList().isEmpty()); QCOMPARE(thread.value("revision").toInt(),2);
+        QVERIFY(lib.act({{"type","pin"},{"editionId","game"},{"pinned",true}}).value("queued").toBool()); QVERIFY(entry(lib).value("pinned").toBool());
+    }
+    void endpointPolicy() {
+        Enrollment e; e.endpoint=QUrl("http://127.0.0.1:3000"); e.transport="tailnet"; QVERIFY(!DeviceLibrary::allowedEndpoint(e)); e.endpoint=QUrl("http://100.100.1.1:3000"); QVERIFY(DeviceLibrary::allowedEndpoint(e)); e.transport.clear(); QVERIFY(!DeviceLibrary::allowedEndpoint(e)); e.endpoint=QUrl("https://example.test"); QVERIFY(DeviceLibrary::allowedEndpoint(e)); e.endpoint=QUrl("https://user:pass@example.test"); QVERIFY(!DeviceLibrary::allowedEndpoint(e));
+    }
+    void privateLinuxStoragePath() {
+        QTemporaryDir dir; QVERIFY(dir.isValid());
+        const QString fallback = dir.path() + "/default";
+        const QString personal = dir.path() + "/personal";
+        QCOMPARE(linuxStoragePath(QString(), fallback), QFileInfo(fallback).canonicalFilePath());
+        QCOMPARE(linuxStoragePath(personal, fallback), QFileInfo(personal).canonicalFilePath());
+        QVERIFY(QFile::setPermissions(personal, QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner | QFileDevice::ReadGroup));
+        QCOMPARE(linuxStoragePath(personal, fallback), QFileInfo(personal).canonicalFilePath());
+        QVERIFY(!(QFileInfo(personal).permissions() & (QFileDevice::ReadGroup | QFileDevice::ReadOther)));
+        QVERIFY(linuxStoragePath("relative", fallback).isEmpty());
+        QVERIFY(linuxStoragePath("/", fallback).isEmpty());
+        QVERIFY(linuxStoragePath(dir.path() + "/../escape", fallback).isEmpty());
+        QFile file(dir.path() + "/file"); QVERIFY(file.open(QIODevice::WriteOnly)); file.close();
+        QVERIFY(linuxStoragePath(file.fileName(), fallback).isEmpty());
+        const QString link = dir.path() + "/link";
+        QVERIFY(QFile::link(personal, link)); QVERIFY(linuxStoragePath(link, fallback).isEmpty());
+    }
+    void launcherEnrollmentIdentity() {
+        QVERIFY(enrollmentDeviceMatches("legion-go", "legion-go"));
+        QVERIFY(enrollmentDeviceMatches("legion-go", QString()));
+        QVERIFY(!enrollmentDeviceMatches("nova", "legion-go"));
+        QVERIFY(!enrollmentDeviceMatches(QString(), "legion-go"));
+        QVERIFY(!enrollmentDeviceMatches("bad\n", "bad\n"));
+        DeviceLibrary unavailable{QString(), Enrollment()};
+        QVERIFY(!unavailable.act({{"type","pin"},{"editionId","game"},{"pinned",true}}).value("ok").toBool());
+        QCOMPARE(unavailable.read().value("sync").toMap().value("state").toString(), QString("unavailable"));
+    }
+};
+QTEST_GUILESS_MAIN(DeviceLibraryTest)
+#include "tst_DeviceLibrary.moc"
