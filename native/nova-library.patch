index 0000000..5f6b8ee
--- /dev/null
+++ b/src/backend/library/DeviceLibrary.cpp
@@ -0,0 +1,327 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "DeviceLibrary.h"
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QHostAddress>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QSqlQuery>
+#include <QTimer>
+#include <QUuid>
+#include <QSet>
+#include <QSharedPointer>
+#include <cmath>
+#include <algorithm>
+
+namespace library {
+namespace {
+const int MaxBytes = 5 * 1024 * 1024;
+QByteArray json(const QVariantMap& m) { return QJsonDocument::fromVariant(m).toJson(QJsonDocument::Compact); }
+QVariantMap object(const QByteArray& b) { return QJsonDocument::fromJson(b).object().toVariantMap(); }
+bool identifier(const QVariant& v) { const QString s = v.toString(); return v.userType() == QMetaType::QString && !s.isEmpty() && s.size() <= 200 && std::none_of(s.begin(), s.end(), [](QChar c) { return c.unicode() < 32; }); }
+bool revision(const QVariant& v) { bool ok; double n = v.toDouble(&ok); return ok && n >= 0 && n <= 2147483646 && std::floor(n) == n && v.userType() != QMetaType::Bool; }
+// Validate every nested value before retaining a network payload. The bridge has no
+// remote launch vocabulary, even when a compromised server adds unknown fields.
+bool boundedValue(const QJsonValue& v, int depth, int& count) {
+    if (depth > 16 || ++count > 1000000) return false;
+    if (v.isString()) return v.toString().size() <= 65536;
+    if (v.isArray()) {
+        if (v.toArray().size() > 10000) return false;
+        for (const QJsonValue& item : v.toArray()) if (!boundedValue(item, depth + 1, count)) return false;
+    } else if (v.isObject()) {
+        const QSet<QString> forbidden = {"command", "launch", "launchCommand", "executable", "token", "authorization", "password", "endpoint", "bootstrapPath", "localPath", "path"};
+        const QJsonObject o = v.toObject();
+        for (auto it = o.begin(); it != o.end(); ++it) if (forbidden.contains(it.key()) || it.key().size() > 256 || !boundedValue(it.value(), depth + 1, count)) return false;
+    }
+    return true;
+}
+QString scope(const QVariantMap& a) { return a.value("type") == "thread-membership" ? "thread:" + a.value("threadId").toString() : "edition:" + a.value("editionId").toString(); }
+QVariantMap failure(const QString& error) { return {{"ok", false}, {"queued", false}, {"error", error}}; }
+void apply(QVariantMap& personal, const QVariantMap& a, const QString& state, const QVariantMap& receipt) {
+    QVariantMap entries = personal.value("entries").toMap();
+    QVariantList threads = personal.value("threads").toList();
+    QString type = a.value("type").toString();
+    if (type == "checkpoint" || type == "status" || type == "pin") {
+        const QString id = a.value("editionId").toString();
+        QVariantMap entry = entries.value(id).toMap();
+        if (!entry.contains("checkpoint")) entry["checkpoint"] = QString();
+        if (!entry.contains("status")) entry["status"] = "unknown";
+        if (type == "checkpoint") entry["checkpoint"] = a.value("text");
+        if (type == "status") entry["status"] = a.value("status");
+        if (type == "pin") entry["pinned"] = a.value("pinned");
+        entry["revision"] = state == "ack" ? receipt.value("revision") : a.value("expectedRevision").toInt() + 1;
+        entry["pending"] = entry.value("pending").toBool() || state == "pending";
+        if (state == "conflict") entry["conflict"] = receipt.value("conflict");
+        entries[id] = entry;
+    } else if (type == "thread-create" || type == "thread-keep") {
+        QString threadId = receipt.value("threadId", "local:" + a.value("actionId").toString()).toString();
+        QVariantMap thread = {{"threadId", threadId}, {"name", a.value("name")}, {"members", a.value("members", QVariantList())}, {"revision", 1}, {"pending", state == "pending"}, {"source", "manual"}};
+        threads.append(thread);
+    } else if (type == "thread-membership") {
+        for (int i = 0; i < threads.size(); ++i) {
+            QVariantMap thread = threads[i].toMap();
+            if (thread.value("threadId") != a.value("threadId")) continue;
+            QVariantList members = thread.value("members").toList();
+            members.removeAll(a.value("editionId"));
+            if (a.value("member").toBool()) members.append(a.value("editionId"));
+            thread["members"] = members;
+            thread["revision"] = a.value("expectedRevision").toInt() + 1;
+            thread["pending"] = thread.value("pending").toBool() || state == "pending";
+            if (state == "conflict") thread["conflict"] = receipt.value("conflict");
+            threads[i] = thread;
+        }
+    }
+    personal["entries"] = entries; personal["threads"] = threads;
+}
+}
+
+DeviceLibrary::DeviceLibrary(QObject* parent)
+#if defined(Q_OS_LINUX) && !defined(Q_OS_ANDROID)
+    : DeviceLibrary(platformStoragePath().isEmpty() ? QString() : platformStoragePath() + "/library.sqlite", platformEnrollment(), nullptr, parent) {}
+#else
+    : DeviceLibrary(platformStoragePath() + "/library.sqlite", platformEnrollment(), nullptr, parent) {}
+#endif
+DeviceLibrary::DeviceLibrary(const QString& path, const Enrollment& enrollment, QNetworkAccessManager* network, QObject* parent)
+    : QObject(parent), m_connection(QUuid::createUuid().toString()), m_enrollment(enrollment),
+      m_network(network ? network : new QNetworkAccessManager(this)) {
+    m_ready = initialize(path);
+    setState(m_ready ? "offline" : "unavailable", m_ready ? "Local library ready" : "Local database unavailable");
+    if (m_ready && snapshot().isEmpty() && !enrollment.bootstrapPath.isEmpty()) {
+        QFile seed(enrollment.bootstrapPath);
+        if (seed.open(QIODevice::ReadOnly) && seed.size() <= MaxBytes) acceptSnapshot(seed.read(MaxBytes + 1));
+    }
+}
+DeviceLibrary::~DeviceLibrary() { m_db.close(); m_db = QSqlDatabase(); QSqlDatabase::removeDatabase(m_connection); }
+bool DeviceLibrary::initialize(const QString& path) {
+    if (path.isEmpty()) return false;
+    if (path != ":memory:") {
+        QDir().mkpath(QFileInfo(path).absolutePath());
+        QFile::setPermissions(QFileInfo(path).absolutePath(), QFileDevice::ReadOwner | QFileDevice::WriteOwner | QFileDevice::ExeOwner);
+    }
+    m_db = QSqlDatabase::addDatabase("QSQLITE", m_connection); m_db.setDatabaseName(path);
+    if (!m_db.open()) return false;
+    if (path != ":memory:") QFile::setPermissions(path, QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+    QSqlQuery q(m_db);
+    return q.exec("PRAGMA journal_mode=WAL") && q.exec("PRAGMA synchronous=FULL") &&
+        q.exec("CREATE TABLE IF NOT EXISTS snapshot (id INTEGER PRIMARY KEY CHECK(id=1), body BLOB NOT NULL)") &&
+        q.exec("CREATE TABLE IF NOT EXISTS actions (seq INTEGER PRIMARY KEY AUTOINCREMENT, id TEXT UNIQUE NOT NULL, hash TEXT NOT NULL, body BLOB NOT NULL, state TEXT NOT NULL, receipt BLOB)");
+}
+QVariantMap DeviceLibrary::snapshot() const { QSqlQuery q(m_db); if (m_ready && q.exec("SELECT body FROM snapshot WHERE id=1") && q.next()) return object(q.value(0).toByteArray()); return {}; }
+void DeviceLibrary::setState(const QString& state, const QString& message) { m_state = state; m_message = message; emit statusChanged(); }
+QVariantMap DeviceLibrary::read(const QVariantMap&) const {
+    QVariantMap result = snapshot();
+    QVariantMap personal = result.value("personal").toMap();
+    if (!personal.contains("entries")) personal["entries"] = QVariantMap();
+    if (!personal.contains("threads")) personal["threads"] = QVariantList();
+    int pending = 0, conflicts = 0;
+    for (const QVariant& value : personal.value("entries").toMap()) {
+        const QVariant conflict = value.toMap().value("conflict");
+        if (!conflict.isNull() && (!conflict.toList().isEmpty() || !conflict.toMap().isEmpty())) ++conflicts;
+    }
+    for (const QVariant& value : personal.value("threads").toList()) if (!value.toMap().value("conflicts").toList().isEmpty()) ++conflicts;
+    QSqlQuery q(m_db);
+    if (m_ready && q.exec("SELECT body,state,receipt FROM actions WHERE state != 'folded' ORDER BY seq")) {
+        while (q.next()) {
+            const QString state = q.value(1).toString();
+            if (state == "pending") ++pending;
+            if (state == "conflict") ++conflicts;
+            apply(personal, object(q.value(0).toByteArray()), state, object(q.value(2).toByteArray()));
+        }
+    }
+    result["personal"] = personal;
+    if (!result.contains("recommendations")) result["recommendations"] = QVariantList();
+    if (!result.contains("threads")) result["threads"] = QVariantList();
+    result["sync"] = QVariantMap{{"state", conflicts ? "conflict" : m_state}, {"message", m_message}, {"pending", pending}, {"conflicts", conflicts}};
+    return result;
+}
+QVariantMap DeviceLibrary::act(const QVariantMap& input) {
+    if (!m_ready) return failure("database_unavailable");
+    QVariantMap a = input;
+    const QString type = a.value("type").toString();
+    QSet<QString> keys = {"type", "actionId", "expectedRevision"};
+    const bool edition = type == "checkpoint" || type == "status" || type == "pin";
+    if (edition) keys.insert("editionId");
+    if (type == "checkpoint") keys.insert("text");
+    else if (type == "status") keys.insert("status");
+    else if (type == "pin") keys.insert("pinned");
+    else if (type == "thread-create") keys.insert("name");
+    else if (type == "thread-keep") { keys.insert("suggestedId"); keys.insert("name"); keys.insert("members"); }
+    else if (type == "thread-membership") { keys.insert("threadId"); keys.insert("editionId"); keys.insert("member"); }
+    else return failure("unsupported_action");
+    for (auto it = a.constBegin(); it != a.constEnd(); ++it) if (!keys.contains(it.key())) return failure("unexpected_field");
+    if ((edition || type == "thread-membership") && !identifier(a.value("editionId"))) return failure("invalid_edition_id");
+    if (type == "checkpoint" && (a.value("text").userType() != QMetaType::QString || a.value("text").toString().size() > 4000 || a.value("text").toString().contains(QChar(0)))) return failure("invalid_checkpoint");
+    if (type == "status" && !QStringList({"unknown", "backlog", "playing", "finished", "abandoned"}).contains(a.value("status").toString())) return failure("invalid_status");
+    if (type == "pin" && a.value("pinned").userType() != QMetaType::Bool) return failure("invalid_pin");
+    if ((type == "thread-create" || type == "thread-keep") && (!identifier(a.value("name")) || a.value("name").toString().size() > 160)) return failure("invalid_thread_name");
+    if (type == "thread-keep") {
+        if (!identifier(a.value("suggestedId")) || a.value("members").userType() != QMetaType::QVariantList || a.value("members").toList().size() > 10000) return failure("invalid_thread");
+        QSet<QString> members;
+        for (const QVariant& id : a.value("members").toList()) { if (!identifier(id) || members.contains(id.toString())) return failure("invalid_member"); members.insert(id.toString()); }
+    }
+    if (type == "thread-membership" && (!identifier(a.value("threadId")) || a.value("member").userType() != QMetaType::Bool || a.value("threadId").toString().startsWith("local:"))) return failure("invalid_thread_membership");
+    // Repeat calls with the same ID retain the original inferred revision.
+    if (a.contains("actionId") && !a.contains("expectedRevision")) {
+        QSqlQuery existing(m_db); existing.prepare("SELECT body FROM actions WHERE id=?"); existing.addBindValue(a.value("actionId"));
+        if (existing.exec() && existing.next()) {
+            const QVariantMap original = object(existing.value(0).toByteArray());
+            if (original.contains("expectedRevision")) a["expectedRevision"] = original.value("expectedRevision");
+        }
+    }
+    const QVariantMap personal = read().value("personal").toMap();
+    if (!a.contains("expectedRevision") && edition) a["expectedRevision"] = personal.value("entries").toMap().value(a.value("editionId").toString()).toMap().value("revision", 0);
+    if (!a.contains("expectedRevision") && type == "thread-membership") {
+        bool found = false;
+        for (const QVariant& item : personal.value("threads").toList()) if (item.toMap().value("threadId") == a.value("threadId")) { a["expectedRevision"] = item.toMap().value("revision", 0); found = true; break; }
+        if (!found) return failure("unknown_thread");
+    }
+    if (a.contains("expectedRevision") && !revision(a.value("expectedRevision"))) return failure("invalid_revision");
+    if (!a.contains("actionId")) a["actionId"] = QUuid::createUuid().toString(QUuid::WithoutBraces);
+    if (!identifier(a.value("actionId"))) return failure("invalid_action_id");
+    const QByteArray body = json(a);
+    const QString hash = QString::fromLatin1(QCryptographicHash::hash(body, QCryptographicHash::Sha256).toHex());
+    QSqlQuery q(m_db); q.prepare("SELECT hash,state,receipt FROM actions WHERE id=?"); q.addBindValue(a.value("actionId"));
+    if (!q.exec()) return failure("database_read_failed");
+    if (q.next()) {
+        if (q.value(0).toString() != hash) return failure("action_id_reused");
+        if (q.value(1) == "pending") return {{"ok", true}, {"queued", true}, {"actionId", a.value("actionId")}};
+        return object(q.value(2).toByteArray());
+    }
+    if (!m_db.transaction()) return failure("database_transaction_failed");
+    q.prepare("INSERT INTO actions(id,hash,body,state) VALUES(?,?,?,'pending')"); q.addBindValue(a.value("actionId")); q.addBindValue(hash); q.addBindValue(body);
+    if (!q.exec() || !m_db.commit()) { m_db.rollback(); return failure("database_commit_failed"); }
+    emit changed(); emit statusChanged();
+    QTimer::singleShot(0, this, [this]() { synchronize(); });
+    return {{"ok", true}, {"queued", true}, {"actionId", a.value("actionId")}};
+}
+
+bool DeviceLibrary::acceptSnapshot(const QByteArray& bytes) {
+    if (!m_ready || bytes.size() > MaxBytes) { setState("error", "Snapshot exceeds limit or database unavailable"); return false; }
+    QJsonParseError error; QJsonDocument doc = QJsonDocument::fromJson(bytes, &error);
+    if (error.error != QJsonParseError::NoError || !doc.isObject()) { setState("error", "Invalid snapshot"); return false; }
+    int count = 0;
+    if (!boundedValue(doc.object(), 0, count)) { setState("error", "Unsafe or unbounded snapshot"); return false; }
+    const QJsonObject s = doc.object(); const QJsonObject p = s.value("personal").toObject();
+    if (s.value("version").toInt() != 1 || !s.value("revision").isString() || !s.value("editions").isArray() || s.value("editions").toArray().size() > 10000 || !s.value("personal").isObject() || !p.value("entries").isObject() || !p.value("threads").isArray() || !s.value("recommendations").isArray() || !s.value("threads").isArray() ||
+        (!m_enrollment.deviceId.isEmpty() && s.value("deviceId").toString() != m_enrollment.deviceId)) { setState("error", "Snapshot schema rejected"); return false; }
+    QSet<QString> ids;
+    for (const QJsonValue& v : s.value("editions").toArray()) {
+        if (!v.isObject() || !identifier(v.toObject().value("editionId").toVariant()) || !v.toObject().value("title").isString() || v.toObject().value("title").toString().isEmpty() || v.toObject().value("title").toString().size() > 500 || ids.contains(v.toObject().value("editionId").toString())) { setState("error", "Invalid edition"); return false; }
+        ids.insert(v.toObject().value("editionId").toString());
+    }
+    const QJsonObject entries = p.value("entries").toObject();
+    if (entries.size() > 10000) return false;
+    for (auto it = entries.begin(); it != entries.end(); ++it) {
+        const QVariantMap e = it.value().toObject().toVariantMap();
+        if (!identifier(it.key()) || !ids.contains(it.key()) || !it.value().isObject() || !e.contains("checkpoint") || !revision(e.value("revision")) || (e.contains("checkpoint") && !e.value("checkpoint").isNull() && e.value("checkpoint").userType() != QMetaType::QString) || !QStringList({"unknown", "backlog", "playing", "finished", "abandoned"}).contains(e.value("status").toString())) { setState("error", "Invalid personal entry"); return false; }
+    }
+    for (const QJsonValue& v : p.value("threads").toArray()) {
+        const QJsonObject t = v.toObject();
+        if (!v.isObject() || !identifier(t.value("threadId").toVariant()) || !identifier(t.value("name").toVariant()) || !revision(t.value("revision").toVariant()) || !t.value("members").isArray()) return false;
+        for (const QJsonValue& id : t.value("members").toArray()) if (!identifier(id.toVariant())) return false;
+    }
+    for (const QJsonValue& v : s.value("recommendations").toArray()) {
+        const QJsonObject r = v.toObject();
+        if (!v.isObject() || !identifier(r.value("editionId").toVariant()) || !r.value("score").isDouble() || !r.value("reason").isString() || !r.value("sources").isArray()) return false;
+    }
+    for (const QJsonValue& v : s.value("threads").toArray()) {
+        const QJsonObject t = v.toObject();
+        if (!v.isObject() || !identifier(t.value("suggestedId").toVariant()) || !identifier(t.value("name").toVariant()) || !t.value("members").isArray() || !t.value("source").isString() || !t.value("reason").isString()) return false;
+        for (const QJsonValue& id : t.value("members").toArray()) if (!identifier(id.toVariant())) return false;
+    }
+    // Never interpret remote strings as paths, credentials, launch routes or commands.
+    if (!m_db.transaction()) return false;
+    QSqlQuery q(m_db); q.prepare("INSERT OR REPLACE INTO snapshot(id,body) VALUES(1,?)"); q.addBindValue(bytes);
+    if (!q.exec() || !q.exec("UPDATE actions SET state='folded' WHERE state='ack'") || !m_db.commit()) { m_db.rollback(); setState("error", "Snapshot commit failed"); return false; }
+    emit changed(); return true;
+}
+
+bool DeviceLibrary::acceptReceipt(const QString& id, const QByteArray& bytes) {
+    if (bytes.size() > MaxBytes) return false;
+    QJsonParseError error; QJsonDocument doc = QJsonDocument::fromJson(bytes, &error);
+    if (error.error != QJsonParseError::NoError || !doc.isObject()) return false;
+    QVariantMap receipt = doc.object().toVariantMap();
+    if (receipt.value("actionId") != id || receipt.value("ok").userType() != QMetaType::Bool || receipt.value("queued").userType() != QMetaType::Bool || receipt.value("queued").toBool()) return false;
+    const bool ok = receipt.value("ok").toBool();
+    if (!ok && (receipt.value("error") != "revision_conflict" || !receipt.value("conflict").canConvert<QVariantMap>())) return false;
+    QSqlQuery q(m_db); q.prepare("SELECT state,receipt,body FROM actions WHERE id=?"); q.addBindValue(id);
+    if (!q.exec() || !q.next()) return false;
+    if (q.value(0) != "pending") return object(q.value(1).toByteArray()) == receipt;
+    const QVariantMap original = object(q.value(2).toByteArray());
+    if (ok && !revision(receipt.value("revision"))) return false;
+    if (ok && (original.value("type") == "thread-create" || original.value("type") == "thread-keep") && !identifier(receipt.value("threadId"))) return false;
+    if (!ok) {
+        const QVariantMap conflict = receipt.value("conflict").toMap();
+        if (conflict.value("current").userType() != QMetaType::QVariantMap || conflict.value("submitted").toMap() != original) return false;
+    }
+    if (!m_db.transaction()) return false;
+    q.prepare("UPDATE actions SET state=?,receipt=? WHERE id=? AND state='pending'"); q.addBindValue(ok ? "ack" : "conflict"); q.addBindValue(bytes); q.addBindValue(id);
+    if (!q.exec() || !m_db.commit()) { m_db.rollback(); return false; }
+    emit changed(); emit statusChanged(); return true;
+}
+QByteArray DeviceLibrary::nextAction() const {
+    QSet<QString> blocked;
+    QSqlQuery q(m_db);
+    if (q.exec("SELECT body,state FROM actions WHERE state IN ('pending','conflict') ORDER BY seq")) while (q.next()) {
+        const QByteArray body = q.value(0).toByteArray(); const QString key = scope(object(body));
+        if (q.value(1) == "conflict") blocked.insert(key);
+        else if (!blocked.contains(key)) return body;
+    }
+    return {};
+}
+bool DeviceLibrary::allowedEndpoint(const Enrollment& e) {
+    const QUrl u = e.endpoint;
+    if (!u.isValid() || u.host().isEmpty() || !u.userInfo().isEmpty() || !u.query().isEmpty() || !u.fragment().isEmpty()) return false;
+    if (u.scheme() == "https") return true;
+    if (u.scheme() != "http" || e.transport != "tailnet") return false;
+    QStringList parts = u.host().split('.');
+    if (parts.size() == 4) {
+        bool ok[4]; int v[4]; for (int i = 0; i < 4; ++i) v[i] = parts[i].toInt(&ok[i]);
+        return ok[0] && ok[1] && ok[2] && ok[3] && v[0] == 100 && v[1] >= 64 && v[1] <= 127 && v[2] >= 0 && v[2] <= 255 && v[3] >= 0 && v[3] <= 255;
+    }
+    const QHostAddress host(u.host());
+    return host.protocol() == QAbstractSocket::IPv6Protocol && host.isInSubnet(QHostAddress("fd7a:115c:a1e0::"), 48);
+}
+void DeviceLibrary::synchronize() {
+    if (m_busy || !m_ready) return;
+    if (!allowedEndpoint(m_enrollment) || m_enrollment.token.isEmpty()) { setState("unavailable", "Device credentials unavailable"); return; }
+    m_busy = true; setState("syncing", "Synchronizing library"); sendNext();
+}
+void DeviceLibrary::sendNext() {
+    const QByteArray body = nextAction();
+    if (body.isEmpty()) { fetchSnapshot(); return; }
+    QUrl url = m_enrollment.endpoint; QString path = url.path(); if (path.endsWith('/')) path.chop(1); url.setPath(path + "/api/v1/game-library/actions");
+    QNetworkRequest req(url); req.setRawHeader("Authorization", "Bearer " + m_enrollment.token); req.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+    req.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+    QNetworkReply* reply = m_network->post(req, body); reply->setReadBufferSize(MaxBytes + 1);
+    QTimer* deadline = new QTimer(reply); deadline->setSingleShot(true); connect(deadline, &QTimer::timeout, reply, &QNetworkReply::abort); deadline->start(20000);
+    auto bytes = QSharedPointer<QByteArray>::create();
+    connect(reply, &QIODevice::readyRead, this, [reply, bytes]() { bytes->append(reply->readAll()); if (bytes->size() > MaxBytes) reply->abort(); });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, bytes, body]() {
+        bytes->append(reply->readAll()); int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        bool accepted = (code == 200 || code == 409) && acceptReceipt(object(body).value("actionId").toString(), *bytes);
+        reply->deleteLater();
+        if (accepted) sendNext(); else { m_busy = false; setState("offline", "Action pending; retry on next synchronization"); }
+    });
+}
+void DeviceLibrary::fetchSnapshot() {
+    QUrl url = m_enrollment.endpoint; QString path = url.path(); if (path.endsWith('/')) path.chop(1); url.setPath(path + "/api/v1/game-library/snapshot");
+    QNetworkRequest req(url); req.setRawHeader("Authorization", "Bearer " + m_enrollment.token); req.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::ManualRedirectPolicy);
+    // Full response also folds acknowledged overlays. Avoid 304 while any ack awaits folding.
+    QNetworkReply* reply = m_network->get(req); reply->setReadBufferSize(MaxBytes + 1);
+    QTimer* deadline = new QTimer(reply); deadline->setSingleShot(true); connect(deadline, &QTimer::timeout, reply, &QNetworkReply::abort); deadline->start(20000);
+    auto bytes = QSharedPointer<QByteArray>::create();
+    connect(reply, &QIODevice::readyRead, this, [reply, bytes]() { bytes->append(reply->readAll()); if (bytes->size() > MaxBytes) reply->abort(); });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, bytes]() {
+        bytes->append(reply->readAll()); bool ok = reply->error() == QNetworkReply::NoError && reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt() == 200 && acceptSnapshot(*bytes);
+        reply->deleteLater(); m_busy = false;
+        setState(ok ? "acknowledged" : "offline", ok ? "Library synchronized" : "Snapshot unavailable; local library retained");
+    });
+}
+} // namespace library
