+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <QObject>
+#include <QVariantMap>
+#include <QSqlDatabase>
+#include <QUrl>
+
+class QNetworkAccessManager;
+
+namespace library {
+
+// Credentials are never exposed through the QObject API or stored in SQLite.
+struct Enrollment {
+    QUrl endpoint;
+    QString deviceId;
+    QString transport;
+    QString bootstrapPath;
+    QByteArray token;
+};
+Enrollment platformEnrollment();
+QString platformStoragePath();
+// Small platform seams used by Linux startup and isolated filesystem tests.
+QString linuxStoragePath(const QString& overridePath, const QString& fallbackPath);
+bool enrollmentDeviceMatches(const QString& enrolledDeviceId, const QString& launcherDeviceId);
+
+class DeviceLibrary : public QObject {
+    Q_OBJECT
+public:
+    explicit DeviceLibrary(QObject* parent = nullptr);
+    DeviceLibrary(const QString& databasePath, const Enrollment& enrollment,
+                  QNetworkAccessManager* network = nullptr, QObject* parent = nullptr);
+    ~DeviceLibrary() override;
+    Q_INVOKABLE QVariantMap read(const QVariantMap& query = QVariantMap()) const;
+    Q_INVOKABLE QVariantMap act(const QVariantMap& action);
+    Q_INVOKABLE void synchronize();
+
+    // Complete bounded validation happens before beginning the replacement transaction.
+    // Also used by the local bootstrap loader and offline behavior harness.
+    bool acceptSnapshot(const QByteArray& bytes);
+    bool acceptReceipt(const QString& actionId, const QByteArray& bytes);
+    QByteArray nextAction() const;
+    static bool allowedEndpoint(const Enrollment& enrollment);
+signals:
+    void changed();
+    void statusChanged();
+private:
+    bool initialize(const QString& databasePath);
+    QVariantMap snapshot() const;
+    void setState(const QString& state, const QString& message);
+    void sendNext();
+    void fetchSnapshot();
+    QSqlDatabase m_db;
+    QString m_connection;
+    Enrollment m_enrollment;
+    QNetworkAccessManager* m_network;
+    bool m_busy = false;
+    bool m_ready = false;
+    QString m_state;
+    QString m_message;
+};
+} // namespace library
